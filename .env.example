# Copy this file to .env and fill in your credentials and model.
# Loaded from the current working directory; environment variables override this file.
DOCGUARD_AI_PROVIDER=groq
GROQ_API_KEY=
DOCGUARD_MODEL=openai/gpt-oss-120b

# To switch providers, comment the active provider/model above first.
# DOCGUARD_AI_PROVIDER=openai
# OPENAI_API_KEY=
# DOCGUARD_MODEL=gpt-4.1-mini
